# 发布签名配置模板
#
# 使用方式：
#   1. 生成密钥库（keystore）：
#        keytool -genkeypair -v -keystore release.jks -alias mykey \
#          -keyalg RSA -keysize 2048 -validity 36500
#   2. 复制本文件为 android/keystore.properties，并按实际情况填写
#   3. 执行 make apk-release，产物会自动使用该签名
#
# 注意：keystore.properties 与 *.jks / *.keystore 均已在 .gitignore 中，
#       请勿提交到仓库；泄露后任何人都能伪造你的应用更新。

# 密钥库文件路径，支持绝对路径，或相对于 android/ 的相对路径
storeFile=release.jks
# 密钥库密码
storePassword=changeit
# 密钥别名
keyAlias=mykey
# 密钥密码
keyPassword=changeit
